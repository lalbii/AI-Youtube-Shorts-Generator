# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
# Optional override; smart-layout otherwise uses assets/models/face_detection_yunet_2023mar.onnx
SMART_LAYOUT_YUNET_MODEL=/path/to/face_detection_yunet.onnx
# Legacy fixed-window compatibility; rolling smart-layout uses the settings below
SMART_LAYOUT_WINDOW_SECONDS=3.0
# Rolling smart-layout samples about 4 times/second and evaluates the latest 1.25 seconds
SMART_LAYOUT_SAMPLE_INTERVAL_SECONDS=0.25
SMART_LAYOUT_ROLLING_WINDOW_SECONDS=1.25
# Conservative normalized grayscale difference used to reset evidence after hard camera cuts
SMART_LAYOUT_SCENE_CUT_THRESHOLD=0.22
